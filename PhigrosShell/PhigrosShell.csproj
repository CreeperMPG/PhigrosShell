<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>phishell</AssemblyName>
    <RootNamespace>PhigrosShell</RootNamespace>
    <AssemblyVersion></AssemblyVersion>
    <FileVersion></FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CreeperMPG.PhiKits.Save\CreeperMPG.PhiKits.Save\src\CreeperMPG.PhiKits.Save\CreeperMPG.PhiKits.Save.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentConsole" Version="0.8.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
    <PackageReference Include="ZXing.Net.Bindings.ImageSharp" Version="0.16.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- 界面文案（扁平键值对） -->
    <EmbeddedResource Include="Resources/lang/*.json" />
    <!-- 更新日志（结构化，与界面文案分开存放） -->
    <EmbeddedResource Include="Resources/changelog/*.json" />
  </ItemGroup>

</Project>
